--- /dev/null
+++ b/src/conf/cards/PMDKI2S.conf
@@ -0,0 +1,116 @@
+#
+# Configuration for PMDK-I2S HDMI audio
+#
+
+PMDKI2S.pcm.hdmi.!0 {
+	@args [ CARD AES0 AES1 AES2 AES3 ]
+	@args.CARD {
+		type string
+	}
+	@args.AES0 {
+		type integer
+	}
+	@args.AES1 {
+		type integer
+	}
+	@args.AES2 {
+		type integer
+	}
+	@args.AES3 {
+		type integer
+	}
+	type hooks
+	slave.pcm {
+		type hw
+		card $CARD
+	}
+	hooks.0 {
+		type ctl_elems
+		hook_args [
+			{
+				interface PCM
+				name "IEC958 Playback Default"
+				device 0
+				lock true
+				preserve true
+				value [ $AES0 $AES1 $AES2 $AES3 ]
+			}
+		]
+	}
+}
+
+PMDKI2S.pcm.hdmi.!1 {
+	@args [ CARD AES0 AES1 AES2 AES3 ]
+	@args.CARD {
